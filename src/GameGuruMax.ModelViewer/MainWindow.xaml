<Window x:Class="GameGuruMax.ModelViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameGuru MAX Model Viewer"
        Height="900" Width="1440"
        MinHeight="680" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico">
    <DockPanel>
        <!-- Concept-style top bar -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BrushBgPanel}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="Bold" VerticalAlignment="Center">
                        <Run Text="GameGuru " Foreground="{StaticResource BrushText}"/>
                        <Run Text="MAX" Foreground="{StaticResource BrushOrange}"/>
                        <Run Text=" Model Viewer" Foreground="{StaticResource BrushTextMuted}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open Folder" Style="{StaticResource ToolbarButton}"
                            Margin="0,0,8,0" Click="SetFilesFolder_Click"/>
                    <Button Content="Refresh" Style="{StaticResource ToolbarButton}"
                            Click="Rescan_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Menu Background="Transparent">
                        <MenuItem Header="File" Foreground="{StaticResource BrushTextMuted}">
                            <MenuItem Header="Set Files folder..." Click="SetFilesFolder_Click"/>
                            <MenuItem Header="Rescan entity bank" Click="Rescan_Click"/>
                            <Separator/>
                            <MenuItem Header="Exit" Click="Exit_Click"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar x:Name="ScanProgress" Width="180" Visibility="Collapsed"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="180"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="460" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- Folders -->
            <Border Grid.Column="0" Style="{StaticResource GlowPanel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Folders" Style="{StaticResource SectionHeader}"/>
                    <TreeView x:Name="FolderTree" SelectedItemChanged="FolderTree_SelectedItemChanged"/>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                          Background="Transparent" ShowsPreview="True"/>

            <!-- Models / Entities -->
            <Border Grid.Column="2" Style="{StaticResource GlowPanel}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Models" Style="{StaticResource SectionHeader}" Margin="0"/>
                            <TextBlock x:Name="EntityCountText" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource BrushTextMuted}" FontSize="12"
                                       Text="Total: 0"/>
                        </StackPanel>
                        <TextBox x:Name="FilterBox" Width="220" HorizontalAlignment="Right"
                                 VerticalContentAlignment="Center" Height="30"
                                 ToolTip="Filter models"
                                 TextChanged="FilterBox_TextChanged"/>
                    </DockPanel>
                    <DataGrid x:Name="EntityGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal"
                              SelectionChanged="EntityGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*"
                                                ElementStyle="{StaticResource EntityGridTextStyle}"/>
                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="140"
                                                ElementStyle="{StaticResource EntityGridTextStyle}"/>
                            <DataGridTextColumn Header="Folder" Binding="{Binding FolderRelative}" Width="160"
                                                ElementStyle="{StaticResource EntityGridTextStyle}"/>
                            <DataGridTextColumn Header="Files" Binding="{Binding AssociatedFiles.Count}" Width="50"
                                                ElementStyle="{StaticResource EntityGridTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Center"
                          Background="Transparent" ShowsPreview="True"/>

            <!-- Preview + Model Info -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="220"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="1.1*" MinHeight="260"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource GlowPanel}" Padding="10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Preview" Style="{StaticResource SectionHeader}"/>
                        <Border Background="#05070A"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,0,8">
                            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8"/>
                        </Border>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                              ResizeDirection="Rows" ShowsPreview="True"
                              Background="Transparent" Cursor="SizeNS"/>

                <Border Grid.Row="2" Style="{StaticResource GlowPanel}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Model Info" Style="{StaticResource SectionHeader}"/>

                        <Border DockPanel.Dock="Top"
                                Background="{StaticResource BrushBgElevated}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,6"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock x:Name="EntityTitle" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushText}"
                                           TextWrapping="Wrap" Margin="0,0,0,3"/>
                                <TextBlock x:Name="PreviewPathText" FontSize="11"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,10,0,0">
                            <Button Content="Move" Style="{StaticResource GreenActionButton}"
                                    Margin="0,0,6,6" Click="Move_Click"/>
                            <Button Content="Delete" Style="{StaticResource BlueActionButton}"
                                    Margin="0,0,0,6" Click="Delete_Click"/>
                            <Button Content="Optimize" Style="{StaticResource ToolbarButton}"
                                    Margin="0,0,6,0" Click="Optimize_Click"
                                    BorderBrush="{StaticResource BrushAccent}"/>
                            <Button Content="Save FPE" Style="{StaticResource OrangeActionButton}"
                                    Click="SaveFpe_Click"/>
                        </UniformGrid>

                        <TabControl>
                            <TabItem Header="Associated files">
                                <ListBox x:Name="AssociatedList" FontSize="11" Margin="0,8,0,0"/>
                            </TabItem>
                            <TabItem Header="FPE fields">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="desc" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="FieldDesc" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="model" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="FieldModel" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="scale" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="FieldScale" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="collisionmode" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="FieldCollisionMode" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6"
                                                      IsEditable="True" IsTextSearchEnabled="True"/>

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="defaultstatic" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="FieldDefaultStatic" Grid.Row="4" Grid.Column="1" Margin="0,0,0,6"
                                                      IsEditable="True"/>

                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="ischaracter" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="FieldIsCharacter" Grid.Row="5" Grid.Column="1" Margin="0,0,0,6"/>
                                        </Grid>

                                        <TextBlock Text="Texture / material maps" Style="{StaticResource SectionHeader}"
                                                   Margin="0,8,0,6" FontSize="12"/>
                                        <TextBlock x:Name="MapFieldsEmptyHint"
                                                   Text="No texture map keys found in this FPE."
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   FontSize="11"
                                                   Margin="0,0,0,6"
                                                   Visibility="Collapsed"/>
                                        <ItemsControl x:Name="MapFieldsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Key}"
                                                                   Style="{StaticResource FieldLabel}"
                                                                   ToolTip="{Binding Key}"/>
                                                        <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Expander Header="Collision mode reference" Margin="0,10,0,0" IsExpanded="False">
                                            <TextBlock Margin="4,6,4,4" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{StaticResource BrushTextMuted}"
                                                       Text="0 — Box shape&#x0a;1 — Polygon shape&#x0a;2 — Sphere shape&#x0a;3 — Cylinder&#x0a;9 — Convex Hull&#x0a;10 — Hull Decomp (Hull Decomposition)&#x0a;11 — No collision / No physics&#x0a;12 — Empty (nothing in collision shape)&#x0a;22 — Animal that follows the terrain landscape&#x0a;40 — Collision boxes defined in the Import Model feature&#x0a;50 — Tree collision"/>
                                        </Expander>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Raw FPE">
                                <TextBox x:Name="RawFpeBox"
                                         Margin="0,8,0,0"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         TextWrapping="NoWrap"/>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
