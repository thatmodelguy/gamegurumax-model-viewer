<Window x:Class="GameGuruMax.ModelViewer.Dialogs.ConfirmFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm" Height="420" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BrushBgDeep}"
        Foreground="{StaticResource BrushText}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="OK" Width="90" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
        <TextBlock x:Name="MessageText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock x:Name="SharedText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{StaticResource BrushWarn}"/>
        <ListBox x:Name="FilesList"/>
    </DockPanel>
</Window>
