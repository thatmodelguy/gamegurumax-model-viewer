<Window x:Class="GameGuruMax.ModelViewer.Dialogs.PickFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Move to folder" Height="480" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgDeep}"
        Foreground="{StaticResource BrushText}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Create" Width="70" Margin="8,0,0,0" Click="CreateFolder_Click"/>
                <TextBox x:Name="NewFolderNameBox" VerticalContentAlignment="Center"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                <Button Content="Move here" Width="100" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="Select destination folder under entitybank:" Margin="0,0,0,8"/>
        <TreeView x:Name="FolderTree"/>
    </DockPanel>
</Window>
