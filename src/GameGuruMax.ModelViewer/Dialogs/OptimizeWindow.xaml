<Window x:Class="GameGuruMax.ModelViewer.Dialogs.OptimizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Optimize textures"
        Height="560" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BrushBgDeep}"
        Foreground="{StaticResource BrushText}">
    <Border Background="{StaticResource BrushBgPanel}"
            BorderBrush="{StaticResource BrushBorderGlow}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="10"
            Padding="14">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <TextBlock x:Name="StatusLine" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8"
                           TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                    <Button x:Name="RunButton" Content="Optimize" Width="110" Style="{StaticResource OrangeActionButton}"
                            IsDefault="True" Click="Run_Click"/>
                </StackPanel>
            </StackPanel>

            <StackPanel>
                <TextBlock x:Name="HeaderText" TextWrapping="Wrap" Margin="0,0,0,12" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushText}" FontSize="14"/>

                <CheckBox x:Name="ConvertCheck"
                          Content="Convert PNG / JPEG to DDS (skip files that are already DDS)"
                          IsChecked="True"/>

                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Max resolution" VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{StaticResource BrushTextMuted}"/>
                    <ComboBox x:Name="ResolutionBox" Width="200" HorizontalAlignment="Left"/>
                </DockPanel>

                <CheckBox x:Name="DeleteOriginalsCheck"
                          Content="Delete original PNG/JPEG after successful DDS conversion"
                          IsChecked="False"/>

                <CheckBox x:Name="FolderCheck"
                          Content="Optimize entire current folder (all models in this folder)"
                          IsChecked="False"
                          Checked="OptionsChanged" Unchecked="OptionsChanged"/>

            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,4,0,12"
                       Text="Already-DDS textures (including surface maps) are skipped for conversion, but will still resize when a max resolution is set. Unconventional sizes (not 512/1024/2048/…) convert at their real pixel size — e.g. 512×1012 stays 512×1012 — so UVs still fit. Use Max resolution only if you want them scaled down."/>

                <TextBlock Text="Files to process" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" Margin="0,0,0,6"/>
                <ListBox x:Name="PlanList" Height="200"
                         Background="{StaticResource BrushBgElevated}"
                         BorderBrush="{StaticResource BrushBorder}"
                         Foreground="{StaticResource BrushText}"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
